# Daemon
# --------------------------------------------------------------------------


class Daemon:
    BADGE_REFRESH_SECONDS = 60.0

    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.stop = threading.Event()
        self.state = BadgeState()
        self.badge = None if args.no_badge else LauncherBadge(args.app_uri)
        self.windows: Optional[WindowAttention] = None
        if not args.no_attention:
            try:
                self.windows = WindowAttention(args.wm_class)
            except OSError as error:
                log.warning("taskbar flashing is disabled: %s", error)
        self._last_badge_emit = float("-inf")

    def apply(self, unread: Optional[Unread]) -> None:
        prev = self.state
        steam_active = self.windows.steam_active() if (self.windows and unread) else False
        state = next_state(prev, unread, steam_active, self.args.count)
        self.state = state

        if state.messages != prev.messages:
            if state.messages:
                log.info("unread: %d message(s) in %d chat(s)", state.messages, unread.chats)
            else:
                log.info("no unread messages")

        if self.windows and (state.attention != prev.attention
                             or (state.attention and state.messages > prev.messages)):
            flagged = self.windows.set_attention(state.attention)
            log.debug("attention %s on %d Steam window(s)", "set" if state.attention else "cleared", flagged)

        now = time.monotonic()
        changed = (state.count, state.attention) != (prev.count, prev.attention)
        # Re-send a non-zero badge now and then, so it comes back after the
        # panel or dock restarts.
        refresh = state.count and now - self._last_badge_emit > self.BADGE_REFRESH_SECONDS
        if self.badge and (changed or refresh):
            self.badge.update(state.count, state.attention)
            self._last_badge_emit = now

    def run(self) -> None:
        waiting_logged = False
        try:
            while not self.stop.is_set():
                session = None
                try:
                    session = DevToolsSession(find_shared_js_context(self.args.port))
                    log.info("connected to Steam on port %d", self.args.port)
                    waiting_logged = False
                    while not self.stop.is_set():
                        self.apply(parse_unread(session.evaluate(UNREAD_EXPRESSION)))
                        self.stop.wait(self.args.interval)
                except (OSError, ValueError, WebSocketError, DevToolsError) as error:
                    if session is not None:
                        log.info("lost connection to Steam: %s", error)
                    elif not waiting_logged:
                        log.info("waiting for Steam on port %d (%s)", self.args.port, error)
                        waiting_logged = True
                    self.apply(None)
                    self.stop.wait(self.args.retry)
                finally:
                    if session is not None:
                        session.close()
        finally:
            self.apply(None)


def print_once(args: argparse.Namespace) -> int:
    try:
        session = DevToolsSession(find_shared_js_context(args.port))
    except (OSError, ValueError, WebSocketError, DevToolsError) as error:
        print(f"cannot reach Steam on port {args.port}: {error}", file=sys.stderr)
        return 1
    try:
        print(json.dumps(session.evaluate(UNREAD_EXPRESSION)))
    finally:
        session.close()
    return 0


def parse_args(argv: Optional[list[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="steam-chat-badge",
        description="Show unread Steam chat messages on the taskbar.")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help="Steam's CEF remote debugging port (default: %(default)s)")
    parser.add_argument("--interval", type=float, default=2.0,
                        help="seconds between unread checks (default: %(default)s)")
    parser.add_argument("--retry", type=float, default=5.0,
                        help="seconds between attempts to reach Steam (default: %(default)s)")
    parser.add_argument("--count", choices=("messages", "chats"), default="messages",
                        help="what the badge number counts (default: %(default)s)")
    parser.add_argument("--app-uri", action="append",
                        help=f"desktop entry to badge, repeatable (default: {DEFAULT_APP_URI})")
    parser.add_argument("--wm-class", default="steam",
                        help="X11 WM_CLASS of the Steam windows (default: %(default)s)")
    parser.add_argument("--no-badge", action="store_true", help="do not show a count badge")
    parser.add_argument("--no-attention", action="store_true", help="do not flash the taskbar entry")
    parser.add_argument("--once", action="store_true",
                        help="print Steam's unread state as JSON and exit")
    parser.add_argument("-v", "--verbose", action="store_true", help="log debug messages")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    args = parser.parse_args(argv)
    if not args.app_uri:
        args.app_uri = [DEFAULT_APP_URI]
    if args.interval <= 0 or args.retry <= 0:
        parser.error("--interval and --retry must be positive")
    return args


def main(argv: Optional[list[str]] = None) -> int:
    args = parse_args(argv)
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(levelname)s: %(message)s" if os.environ.get("INVOCATION_ID") else "%(asctime)s %(levelname)s: %(message)s",
    )
    if args.once:
        return print_once(args)

    daemon = Daemon(args)

    def request_stop(signum: int, _frame: Any) -> None:
        log.info("stopping (%s)", signal.Signals(signum).name)
        daemon.stop.set()

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    daemon.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
